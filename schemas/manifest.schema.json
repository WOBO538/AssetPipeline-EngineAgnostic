{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eap.local/schemas/manifest.schema.json",
  "title": "Engine-Agnostic Asset Pipeline Manifest",
  "description": "一份批次清单：描述从 PCG/AIGC 生成、经中台转换后，供 UE5 与 Unity 消费端读取的资产集合。",
  "type": "object",
  "required": ["manifestVersion", "pipelineId", "generatedAt", "units", "assets"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "pipelineId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "units": { "type": "string", "enum": ["m", "cm"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["pcg", "aigc", "manual", "mixed"] },
        "tool": { "type": "string" },
        "workflowId": { "type": "string" },
        "seed": { "type": "integer" },
        "note": { "type": "string" }
      }
    },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "name", "category", "type", "model", "textures", "material", "engineTargets"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "name": { "type": "string" },
        "category": { "type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$" },
        "type": { "type": "string", "enum": ["static_mesh", "skinned_mesh", "material_only"] },
        "model": {
          "type": "object",
          "required": ["path", "format", "unit", "upAxis", "forwardAxis", "triCount"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "source": { "type": "string", "enum": ["file", "engine"] },
            "format": { "type": "string", "enum": ["gltf2.0", "fbx", "obj", "engine_native"] },
            "unit": { "type": "string", "enum": ["m", "cm"] },
            "upAxis": { "type": "string", "enum": ["Y", "Z"] },
            "forwardAxis": { "type": "string", "enum": ["X", "Y", "Z", "-X", "-Z"] },
            "boundingBoxM": {
              "type": "object",
              "required": ["min", "max"],
              "additionalProperties": false,
              "properties": {
                "min": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                "max": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
              }
            },
            "triCount": { "type": "integer", "minimum": 0 }
          }
        },
        "textures": {
          "type": "object",
          "description": "v1.1：允许空对象，但仅当 material.template == \"none\"（引擎默认材质）；校验器强制该条件。v1.13 新增可选 slots[]。",
          "properties": {
            "slots": {
              "type": "array",
              "description": "v1.13：按 glb 材质槽拆贴图，顺序 = glb materials 下标 = primitive 顺序。",
              "items": {
                "type": "object",
                "required": ["slot", "material", "alphaMode"],
                "additionalProperties": false,
                "properties": {
                  "slot": { "type": "integer", "minimum": 0 },
                  "material": { "type": "string" },
                  "alphaMode": { "type": "string", "enum": ["OPAQUE", "MASKED", "BLEND"] },
                  "cutoff": { "type": "number" },
                  "BaseColor": { "$ref": "#/$defs/texture" },
                  "Normal": { "$ref": "#/$defs/texture" },
                  "ORM": { "$ref": "#/$defs/texture" }
                }
              }
            }
          },
          "propertyNames": { "enum": ["BaseColor", "Normal", "Roughness", "Metallic", "AO", "ORM", "Height", "slots"] },
          "patternProperties": {
            "^(BaseColor|Normal|Roughness|Metallic|AO|ORM|Height)$": { "$ref": "#/$defs/texture" }
          },
          "additionalProperties": false
        },
        "material": {
          "type": "object",
          "required": ["template"],
          "additionalProperties": false,
          "properties": {
            "template": { "type": "string" },
            "unityShader": { "type": "string" },
            "params": { "type": "object", "additionalProperties": { "type": ["number", "boolean"] } },
            "channelPacking": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "source": { "type": "string", "enum": ["UE", "Unity", "canonical"] },
                "target": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        },
        "collision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["auto_convex", "box", "none"] }
          }
        },
        "pivot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["bbox_center", "center_bottom", "none"] },
            "offsetM": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          }
        },
        "lods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "triCount"],
            "additionalProperties": false,
            "properties": {
              "level": { "type": "integer", "minimum": 1 },
              "triCount": { "type": "integer", "minimum": 0 },
              "path": { "type": "string" }
            }
          }
        },
        "placements": {
          "type": "object",
          "description": "v1.1：同一网格的 N 个实例（PCG 散点）。坐标/旋转/缩放单位 m 与 deg。",
          "required": ["space", "count", "items"],
          "additionalProperties": false,
          "properties": {
            "space": { "type": "string", "enum": ["world", "local"] },
            "unit": { "type": "string", "enum": ["m"] },
            "count": { "type": "integer", "minimum": 1 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["t", "r", "s"],
                "additionalProperties": false,
                "properties": {
                  "t": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                  "r": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                  "s": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
                }
              }
            }
          }
        },
        "engineTargets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "UE5": {
              "type": "object",
              "required": ["destPath"],
              "additionalProperties": false,
              "properties": {
                "destPath": { "type": "string", "pattern": "^/Game/" },
                "materialInstance": { "type": "string" },
                "textureSettings": { "type": "object", "additionalProperties": true }
              }
            },
            "Unity": {
              "type": "object",
              "required": ["destPath"],
              "additionalProperties": false,
              "properties": {
                "destPath": { "type": "string", "pattern": "^Assets/" },
                "shader": { "type": "string" },
                "propertyMap": { "type": "object", "additionalProperties": { "type": "string" } },
                "modelPath": { "type": "string", "description": "v1.2：Unity 侧模型路径（通常为 fbx），缺省回落到 model.path" },
                "materialPathPrefix": { "type": "string", "pattern": "^Assets/", "description": "v1.2：材质输出目录前缀，默认 Assets/EAP/Trees" }
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "pass"],
            "additionalProperties": false,
            "properties": {
              "rule": { "type": "string" },
              "pass": { "type": "boolean" },
              "value": { "type": ["number", "string", "boolean"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "texture": {
      "type": "object",
      "required": ["path", "srgb"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "srgb": { "type": "boolean" },
        "size": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
        "channels": { "type": "string" },
        "channelCount": { "type": "integer", "minimum": 1, "description": "v1.13：PNG 通道数（RGBA=4）" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "v1.13：贴图字节 SHA256，落位端对磁盘复核" },
        "source": { "type": "string", "enum": ["glb-embedded"], "description": "v1.2：贴图来源；老文件可省略" }
      }
    }
  }
}
