__pycache__/
*.pyc
.venv/
# 示例资产与报告不入库（体积大 / 每次跑都变）
assets/models/
assets/textures/
# 下载的原始树资产不入库（体积大）；只保留来源/许可证清单
assets/raw/*
!assets/raw/trees/
assets/raw/trees/*
!assets/raw/trees/source_assets.json
*_report.json
*_report.md
# RHI 材质编译复检证据（每次跑都变，不入库）
docs/material_compile_check*.json

# Unity 消费端跑完写在 manifest 旁边的报告（每次跑都会变，不入库）
*.unity_report.md
*.unity_verify.json
*.unity_log.txt
*.unity_verify.unity_log.txt
# Unity placements 落位证据（每次跑都会变，不入库）
*.unity_placements_verify.json
*.unity_placements_log.txt
*.unity_placements_verify.unity_log.txt

# fbx 转换产物与报告要入库（两棵树的 fbx + 贴图）
!docs/fbx_convert_report.json
!assets/raw/trees/fbx/
!assets/raw/trees/fbx/*.fbx

# 编辑器里 stage() 的运行期证据（每次跑时间戳都变）
docs/placed_level_stage.json
